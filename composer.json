{
    "name": "roadrunner-php/version-checker",
    "description": "The package for checking the version of the RoadRunner",
    "keywords": [
        "roadrunner-php",
        "roadrunner",
        "version-checker"
    ],
    "homepage": "https://github.com/roadrunner-php/version-checker",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "symfony/process": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "composer-runtime-api": "^2.0",
        "composer/semver": "^3.3"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "spiral/code-style": "^2.3.1",
        "testo/bridge-mockery": "^0.1.2",
        "testo/testo": "^0.10.55",
        "vimeo/psalm": "^6 || ^7"
    },
    "autoload": {
        "psr-4": {
            "RoadRunner\\VersionChecker\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoadRunner\\VersionChecker\\Tests\\": "tests/src"
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff",
        "cs:fix": "php-cs-fixer fix -v",
        "psalm": "vendor/bin/psalm --config=psalm.xml ./src",
        "test": "vendor/bin/testo"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
